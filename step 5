# ── 1. Environmental Parameters ───────────────────────────────────────────
CO2_PRC = 90.0  # Carbon Price (€/ton)

# Emission Factors (ton/MWh)
EF_WOOD = 0.000 
EF_GAS  = 0.202 
EF_ELEC = 0.082 

print(f"Carbon Price: {CO2_PRC} EUR/ton")
